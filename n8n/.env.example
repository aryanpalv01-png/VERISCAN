# ==============================================================================
# VeriScan n8n Orchestration Environment Variables
# ==============================================================================

# --- System & Timezone ---
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# --- Security Encryption Key ---
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_a_secure_32_byte_hex_key

# --- Host and Webhook Settings ---
# In production, set these to your public domain / reverse proxy URL
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# --- Database Backend (sqlite or postgresdb) ---
# Default is 'sqlite'. To use Supabase or external PostgreSQL, set DB_TYPE=postgresdb
DB_TYPE=sqlite
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true

# --- VeriScan Services (FastAPI Worker, GPU Worker, Supabase) ---
# When accessing services running on the host from inside Docker on Linux:
LIGHTWEIGHT_URL=http://host.docker.internal:8000
GPU_URL=http://host.docker.internal:8000

# Supabase Credentials (matches SIH-2026/N8N_SUPABASE_SETUP.md)
SUPABASE_URL=https://dubwryhfjyeuilahaknw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
HF_API_TOKEN=
